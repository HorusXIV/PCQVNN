Bootstrap: docker
From: python:3.12-slim

%labels
    Author Lukas Breiter
    Description PCQVNN runtime for architecture comparison experiments

%post
    apt-get update
    apt-get install -y --no-install-recommends build-essential git
    rm -rf /var/lib/apt/lists/*

    python -m pip install --upgrade pip
    # Pin a CUDA 12.4 PyTorch build explicitly instead of taking whatever the
    # newest default wheel on PyPI happens to be at image-build time.
    python -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu124 \
        torch==2.5.1
    python -m pip install --no-cache-dir \
        numpy \
        scipy \
        scikit-learn \
        pandas \
        pyyaml \
        matplotlib \
        tqdm

    mkdir -p /workspace /outputs

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/workspace/src:${PYTHONPATH}

%runscript
    cd /workspace
    exec python -m qvnn_pc.architecture_comparison "$@"
